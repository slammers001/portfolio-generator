{
  "name": "personal-website-generator",
  "version": "2.0.0",
  "description": "Generate a portfolio website from the browser or the command line",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.3.7",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}